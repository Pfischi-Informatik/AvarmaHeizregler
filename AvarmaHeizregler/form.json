{
    "elements": [
        {
            "type": "ExpansionPanel",
            "caption": "Verbindung",
            "expanded": true,
            "items": [
                { "type": "ValidationTextBox", "name": "Host", "caption": "Modbus-TCP-Gateway (IP)" },
                { "type": "NumberSpinner", "name": "Port", "caption": "Port" },
                { "type": "NumberSpinner", "name": "SlaveID", "caption": "Slave-ID (P108)", "minimum": 1, "maximum": 247 },
                { "type": "NumberSpinner", "name": "Timeout", "caption": "Timeout", "suffix": "s", "minimum": 1 }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Funktionen",
            "expanded": true,
            "items": [
                { "type": "CheckBox", "name": "EnablePolling", "caption": "Abfrage aktiv (Betriebswerte zyklisch lesen)" },
                { "type": "NumberSpinner", "name": "PollInterval", "caption": "Abfrageintervall", "suffix": "s", "minimum": 10 },
                { "type": "NumberSpinner", "name": "ParamInterval", "caption": "Parameter-Leseintervall", "suffix": "s", "minimum": 60 },
                { "type": "CheckBox", "name": "EnableParamWrite", "caption": "Parameter schreiben erlauben (Hauptschalter; einzeln in der Tabelle unter \"Schreiben\")" },
                { "type": "CheckBox", "name": "SyncP01", "caption": "P01 beim Moduswechsel mitschreiben" },
                { "type": "NumberSpinner", "name": "WriteDelay", "caption": "Schreibverzögerung nach letzter Änderung", "suffix": "s", "minimum": 0 },
                { "type": "NumberSpinner", "name": "WriteRetries", "caption": "Schreibversuche", "minimum": 1 },
                { "type": "CheckBox", "name": "EnableControl", "caption": "Heizregler (Sollwertführung P02, Taktsperre, Heizgrenze)" }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Datenpunkte (Auswahl der Variablen)",
            "items": [
                { "type": "Label", "caption": "Aktiv = Variable anlegen. Abwählen löscht die Variable samt Archivdaten. Schreiben = Parameter darf aus Symcon geschrieben werden (nur bei Bereich ≠ \"nur lesen\"). \"Heizregler: immer aktiv\" (grün bei eingeschaltetem Heizregler) = wird unabhängig vom Haken angelegt. Änderungen erst mit \"Übernehmen\" wirksam." },
                {
                    "type": "List",
                    "name": "Selection",
                    "caption": "Datenpunkte",
                    "rowCount": 25,
                    "add": false,
                    "delete": false,
                    "columns": [
                        { "caption": "Aktiv", "name": "Active", "width": "70px", "edit": { "type": "CheckBox" } },
                        { "caption": "Name", "name": "Name", "width": "auto" },
                        { "caption": "Gruppe", "name": "Group", "width": "160px" },
                        { "caption": "Adresse", "name": "Address", "width": "140px" },
                        { "caption": "Bereich", "name": "Range", "width": "120px" },
                        { "caption": "Schreiben", "name": "Write", "width": "90px", "edit": { "type": "CheckBox" } },
                        { "caption": "Hinweis", "name": "Note", "width": "180px" },
                        { "caption": "Ident", "name": "Ident", "width": "170px", "save": true }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Heizregler: Heizkurve (Rücklauf-Ziel)",
            "items": [
                { "type": "NumberSpinner", "name": "TaCold", "caption": "Kalter Punkt: Aussentemperatur", "suffix": "°C", "digits": 1 },
                { "type": "NumberSpinner", "name": "RlCold", "caption": "Kalter Punkt: Rücklauf-Ziel", "suffix": "°C", "digits": 1 },
                { "type": "NumberSpinner", "name": "TaWarm", "caption": "Warmer Punkt: Aussentemperatur", "suffix": "°C", "digits": 1 },
                { "type": "NumberSpinner", "name": "RlWarm", "caption": "Warmer Punkt: Rücklauf-Ziel", "suffix": "°C", "digits": 1 },
                { "type": "NumberSpinner", "name": "Offset", "caption": "Parallelverschiebung", "suffix": "K", "digits": 1 },
                { "type": "NumberSpinner", "name": "SpreadFallback", "caption": "Spreizung, solange noch nicht gemessen", "suffix": "K", "digits": 1 },
                { "type": "NumberSpinner", "name": "FlowMin", "caption": "Vorlauf-Sollwert minimal", "suffix": "°C" },
                { "type": "NumberSpinner", "name": "FlowMax", "caption": "Vorlauf-Sollwert maximal", "suffix": "°C" },
                { "type": "NumberSpinner", "name": "HeatLimit", "caption": "Heizgrenze (1-h-Mittel Aussentemperatur)", "suffix": "°C", "digits": 1 }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Heizregler: Raumkorrektur",
            "items": [
                { "type": "SelectVariable", "name": "RoomTempVar", "caption": "Raumtemperatur (leer = keine Korrektur)" },
                { "type": "NumberSpinner", "name": "RoomTarget", "caption": "Raum-Zieltemperatur", "suffix": "°C", "digits": 1 },
                { "type": "NumberSpinner", "name": "CorrStep", "caption": "Schrittweite", "suffix": "K", "digits": 1 },
                { "type": "NumberSpinner", "name": "CorrIntervalMin", "caption": "Schritt alle", "suffix": "min" },
                { "type": "NumberSpinner", "name": "CorrMax", "caption": "Korrektur maximal ±", "suffix": "K", "digits": 1 }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Heizregler: Sollwertführung und Taktsperre",
            "items": [
                { "type": "NumberSpinner", "name": "RaiseIntervalMin", "caption": "Anheben bei laufendem Verdichter: höchstens 1 K alle", "suffix": "min" },
                { "type": "NumberSpinner", "name": "LowerMaxWaitMin", "caption": "Absenkbremse: spätestens 1 K absenken nach", "suffix": "min" },
                { "type": "NumberSpinner", "name": "CycleStarts", "caption": "Taktsperre auslösen bei Starts", "minimum": 2 },
                { "type": "NumberSpinner", "name": "CycleWindowMin", "caption": "innerhalb von", "suffix": "min" },
                { "type": "NumberSpinner", "name": "LockMin", "caption": "Sperrdauer", "suffix": "min" },
                { "type": "NumberSpinner", "name": "BlockSetpoint", "caption": "Sollwert Heizen während Sperre / über Heizgrenze", "suffix": "°C", "minimum": 10, "maximum": 30 }
            ]
        }
    ],
    "actions": [
        { "type": "Button", "caption": "Jetzt abfragen", "onClick": "AVHR_Update($id);" },
        { "type": "Button", "caption": "Parameter jetzt lesen", "onClick": "AVHR_ReadParameters($id);" },
        { "type": "Button", "caption": "Taktsperre aufheben", "onClick": "AVHR_ResetLock($id);" }
    ],
    "status": [
        { "code": 102, "icon": "active", "caption": "Bereit" },
        { "code": 201, "icon": "error", "caption": "Keine Gateway-Adresse eingetragen" }
    ]
}
